<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk vaut 26, donc l'icone adaptative suffit : aucun PNG de repli n'est
     necessaire pour les anciennes versions d'Android.
     Fond noir de la marque, embleme NEXA au-dessus, silhouette dediee pour les
     icones thematiques. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/nexa_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
