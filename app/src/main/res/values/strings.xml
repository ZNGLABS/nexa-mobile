<resources>
    <!-- Nom TEMPORAIRE, le temps du hackathon.
         L'application publiee sur le dApp Store s'appelle deja NEXA et porte la meme
         icone : deux icones identiques sur le meme telephone, on finit par ouvrir la
         mauvaise. « Sentinel » dit aussi ce que cette couche fait de plus — surveiller.
         Au moment de la fusion dans fr.nexaexchange.dex (apres le 9 octobre), il n'y
         aura plus qu'une application et le nom redeviendra NEXA. -->
    <string name="app_name">NEXA Sentinel</string>

    <string name="channel_monitor">Background monitor</string>
    <string name="channel_monitor_desc">Silent, permanent notice shown while NEXA watches prices in the background.</string>
    <string name="channel_alerts">Price alerts</string>
    <string name="channel_alerts_desc">Fires when a market you are watching crosses your price.</string>

    <string name="monitor_title">NEXA is watching the market</string>
    <string name="monitor_starting">Starting…</string>
