<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis = 1 800 000 (30 min), le minimum qu'Android accepte d'honorer.
     La premiere version valait 0, en supposant que le service de premier plan
     suffirait. Faux : un widget pose alors que le moniteur est arrete ne se serait
     JAMAIS mis a jour. Ce filet de securite garantit qu'il vit meme sans service.
     Quand le service tourne, c'est lui qui rafraichit toutes les 60 s, et le widget
     va aussi chercher son prix lui-meme au moment ou on le pose. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="70dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_nexa"
    android:previewLayout="@layout/widget_nexa"
    android:description="@string/widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
